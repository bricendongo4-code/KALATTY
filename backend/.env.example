PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
JWT_SECRET=change_this_to_a_long_random_secret
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_supabase_publishable_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5-mini
PAYMENT_PROVIDER=pending_configuration
# Accorde temporairement l'acces aux cours payants sans debit reel.
# A desactiver des que CinetPay est configure en production.
COURSE_TEST_ACCESS_ENABLED=true
CINETPAY_API_KEY=your_cinetpay_api_key
CINETPAY_SITE_ID=your_cinetpay_site_id
PUBLIC_API_URL=https://your-backend.example.com
MEDIA_SIGNED_URL_TTL_SECONDS=3600

# Agent supervision: DB migration 20261103 required. No LLM charges until enabled in Control Center.
KALATTY_PLATFORM_ADMIN_EMAIL=owner@example.com
KALATTY_AI_MODEL=gpt-5-mini
# Fine-grained token scoped to KALATTY only: contents + pull requests write, checks/actions read.
# Keep server-side; never prefix with NEXT_PUBLIC_.
KALATTY_AGENT_GITHUB_TOKEN=
